<Window x:Class="HaengSungAOI_WPF.Views.RobotJogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="clr-namespace:HaengSungAOI_WPF.Utils"
    Title="{Binding Title}" Height="850" Width="1400" 
    Background="#1e1e2f" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TITLE ================= -->
        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" Text="Robot Jog Controls" 
        FontSize="28" FontWeight="Bold" Foreground="White"
        HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Row="1" x:Name="JogControlsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>
            <!-- ========================================================= -->
            <!-- ===================== LEFT SIDE - AXIS CONTROLS ========= -->
            <!-- ========================================================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <!-- PCB Infeed Robot Axes (X1, Y1, C1) -->
                    <Grid x:Name="InfeedAxesGroup" Visibility="{Binding InfeedAxesVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ================= AXIS X1 ================= -->
                        <GroupBox Grid.Row="0" Foreground="White" BorderBrush="#444" FontWeight="Bold" Padding="5">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Axis X1 - PCB Infeed Robot X"/>
                                    <TextBlock Text=" [" Foreground="Gray"/>
                                    <TextBlock Text="{Binding PosX, StringFormat={}{0:F3}}" Foreground="Yellow"/>
                                    <TextBlock Text=" mm]" Foreground="Gray"/>
                                </StackPanel>
                            </GroupBox.Header>
                            <StackPanel Margin="5" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Servo ON" Tag="HMI_AX1_ServoON_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX1_ServoON_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                    <Button Content="ORG" Tag="HMI_AX1_ORG_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX1_ORG_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Move" Tag="HMI_AX1_Move_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX1_Move_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Idle" Tag="HMI_AX1_Pos1_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX1_Pos1_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Pickup" Tag="HMI_AX1_Pos2_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX1_Pos2_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Place" Tag="HMI_AX1_Pos3_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX1_Pos3_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <Separator Grid.Row="1" Background="#444"/>

                        <!-- ================= AXIS Y1 ================= -->
                        <GroupBox Grid.Row="2" Foreground="White" BorderBrush="#444" FontWeight="Bold" Padding="5">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Axis Y1 - PCB Infeed Robot Y"/>
                                    <TextBlock Text=" [" Foreground="Gray"/>
                                    <TextBlock Text="{Binding PosY, StringFormat={}{0:F3}}" Foreground="Yellow"/>
                                    <TextBlock Text=" mm]" Foreground="Gray"/>
                                </StackPanel>
                            </GroupBox.Header>
                            <StackPanel Margin="5" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Servo ON" Tag="HMI_AY1_ServoON_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AY1_ServoON_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                    <Button Content="ORG" Tag="HMI_AY1_ORG_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AY1_ORG_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Move" Tag="HMI_AY1_Move_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AY1_Move_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Idle" Tag="HMI_AY1_Pos1_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Pickup" Tag="HMI_AY1_Pos2_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Place" Tag="HMI_AY1_Pos3_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="#232336" Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                       

                        <Separator Grid.Row="3" Background="#444"/>

                        <!-- ================= AXIS C1 ================= -->
                        <GroupBox Grid.Row="4" Foreground="White" BorderBrush="#444" FontWeight="Bold" Padding="5" Visibility="{Binding VisibilityAxis3}">
