    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Robot Jog Controls" Height="850" Width="1400" 
    Background="#1e1e2f" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TITLE ================= -->
        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" Text="Robot Jog Controls" 
        FontSize="28" FontWeight="Bold" Foreground="White"
        HorizontalAlignment="Center" Margin="0,0,0,20"/>

