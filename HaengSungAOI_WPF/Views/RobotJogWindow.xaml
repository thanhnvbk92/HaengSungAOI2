                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Servo ON" Tag="HMI_AX1_ServoON_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="ORG" Tag="HMI_AX1_ORG_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
