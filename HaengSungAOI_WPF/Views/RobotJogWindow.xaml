                                    <Button Content="Focus 1" Tag="HMI_AZ4_Pos2_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Focus 2" Tag="HMI_AZ4_Pos3_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Focus 3" Tag="HMI_AZ4_Pos4_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <Separator Grid.Row="1" Background="#444"/>

                        <!-- ================= AXIS C4 (Rotation) ================= -->
                        <GroupBox Grid.Row="2" Header="Axis C4 - Inspect 1 C (Rotation)" Foreground="White" BorderBrush="#444" FontWeight="Bold" Padding="5">
                            <StackPanel Margin="5" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Servo ON" Tag="HMI_AC4_ServoON_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="ORG" Tag="HMI_AC4_ORG_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Move" Tag="HMI_AC4_Move_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Idle" Tag="HMI_AC4_Pos1_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Focus 1" Tag="HMI_AC4_Pos2_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Focus 2" Tag="HMI_AC4_Pos3_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Focus 3" Tag="HMI_AC4_Pos4_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>

                    <!-- Inspection Robot 2 Axes (Z5, C5) -->
                    <Grid x:Name="Inspect2AxesGroup" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ================= AXIS Z5 (Focus) ================= -->
                        <GroupBox Grid.Row="0" Header="Axis Z5 - Inspect 2 Z" Foreground="White" BorderBrush="#444" FontWeight="Bold" Padding="5">
                            <StackPanel Margin="5" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Servo ON" Tag="HMI_AZ5_ServoON_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="ORG" Tag="HMI_AZ5_ORG_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Move" Tag="HMI_AZ5_Move_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Idle" Tag="HMI_AZ5_Pos1_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Focus 1" Tag="HMI_AZ5_Pos2_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Focus 2" Tag="HMI_AZ5_Pos3_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Focus 3" Tag="HMI_AZ5_Pos4_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Unload" Tag="HMI_AZ5_Pos5_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <Separator Grid.Row="1" Background="#444"/>

                        <!-- ================= AXIS C5 (Rotation) ================= -->
                        <GroupBox Grid.Row="2" Header="Axis C5 - Inspect 2 C (Rotation)" Foreground="White" BorderBrush="#444" FontWeight="Bold" Padding="5">
                            <StackPanel Margin="5" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Servo ON" Tag="HMI_AC5_ServoON_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="ORG" Tag="HMI_AC5_ORG_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Move" Tag="HMI_AC5_Move_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Idle" Tag="HMI_AC5_Pos1_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Focus 1" Tag="HMI_AC5_Pos2_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Focus 2" Tag="HMI_AC5_Pos3_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Focus 3" Tag="HMI_AC5_Pos4_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Unload" Tag="HMI_AC5_Pos5_PB" Width="55" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================================================= -->
            <!-- ===================== CENTER - SPEED AREA =============== -->
            <!-- ========================================================= -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="20">
                <TextBlock Text="Jog Speed Settings" Foreground="#87CEEB" FontWeight="Bold" FontSize="16" Margin="0,0,0,20"/>

                <StackPanel x:Name="JogSpeedPanel">
                    <StackPanel x:Name="JogSpeedAxis1Panel" Orientation="Horizontal" Margin="5,5">
                        <TextBlock x:Name="JogSpeedAxis1Label" Text="Axis 1 Speed:" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" Width="110" Margin="0,0,10,0"/>
                        <TextBox x:Name="JogSpeedAxis1TextBox" Width="100" Text="0" Background="#303040" Foreground="White" BorderBrush="#444" VerticalContentAlignment="Center" Padding="4,2" KeyDown="JogSpeedTextBox_KeyDown"/>
                        <Button Content="W" Width="30" Height="24" Margin="5,0,0,0" Background="#4A7A4A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Click="WriteJogSpeed_Click" Tag="Axis1" ToolTip="Write to PLC"/>
                        <Button Content="R" Width="30" Height="24" Margin="3,0,0,0" Background="#4A4A7A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Click="ReadJogSpeed_Click" Tag="Axis1" ToolTip="Read from PLC"/>
                    </StackPanel>
                    <StackPanel x:Name="JogSpeedAxis2Panel" Orientation="Horizontal" Margin="5,5">
                        <TextBlock x:Name="JogSpeedAxis2Label" Text="Axis 2 Speed:" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" Width="110" Margin="0,0,10,0"/>
                        <TextBox x:Name="JogSpeedAxis2TextBox" Width="100" Text="0" Background="#303040" Foreground="White" BorderBrush="#444" VerticalContentAlignment="Center" Padding="4,2" KeyDown="JogSpeedTextBox_KeyDown"/>
                        <Button Content="W" Width="30" Height="24" Margin="5,0,0,0" Background="#4A7A4A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Click="WriteJogSpeed_Click" Tag="Axis2" ToolTip="Write to PLC"/>
                        <Button Content="R" Width="30" Height="24" Margin="3,0,0,0" Background="#4A4A7A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Click="ReadJogSpeed_Click" Tag="Axis2" ToolTip="Read from PLC"/>
                    </StackPanel>
                    <StackPanel x:Name="JogSpeedAxis3Panel" Orientation="Horizontal" Margin="5,5" Visibility="Collapsed">
                        <TextBlock x:Name="JogSpeedAxis3Label" Text="Axis 3 Speed:" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" Width="110" Margin="0,0,10,0"/>
                        <TextBox x:Name="JogSpeedAxis3TextBox" Width="100" Text="0" Background="#303040" Foreground="White" BorderBrush="#444" VerticalContentAlignment="Center" Padding="4,2" KeyDown="JogSpeedTextBox_KeyDown"/>
                        <Button Content="W" Width="30" Height="24" Margin="5,0,0,0" Background="#4A7A4A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Click="WriteJogSpeed_Click" Tag="Axis3" ToolTip="Write to PLC"/>
                        <Button Content="R" Width="30" Height="24" Margin="3,0,0,0" Background="#4A4A7A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Click="ReadJogSpeed_Click" Tag="Axis3" ToolTip="Read from PLC"/>
                    </StackPanel>
                    <StackPanel x:Name="JogSpeedAxis4Panel" Orientation="Horizontal" Margin="5,5" Visibility="Collapsed">
                        <TextBlock x:Name="JogSpeedAxis4Label" Text="Axis 4 Speed:" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" Width="110" Margin="0,0,10,0"/>
                        <TextBox x:Name="JogSpeedAxis4TextBox" Width="100" Text="0" Background="#303040" Foreground="White" BorderBrush="#444" VerticalContentAlignment="Center" Padding="4,2" KeyDown="JogSpeedTextBox_KeyDown"/>
                        <Button Content="W" Width="30" Height="24" Margin="5,0,0,0" Background="#4A7A4A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Click="WriteJogSpeed_Click" Tag="Axis4" ToolTip="Write to PLC"/>
                        <Button Content="R" Width="30" Height="24" Margin="3,0,0,0" Background="#4A4A7A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Click="ReadJogSpeed_Click" Tag="Axis4" ToolTip="Read from PLC"/>
                    </StackPanel>
                </StackPanel>

                <Separator Margin="10,15,10,10" Background="#444"/>

                <Button Content="Read All Speeds" Height="30" Width="180" Margin="5" Background="#4A4A7A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Click="ReadAllJogSpeeds_Click" ToolTip="Read all jog speeds from PLC"/>
                <Button Content="Write All Speeds" Height="30" Width="180" Margin="5" Background="#4A7A4A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Click="WriteAllJogSpeeds_Click" ToolTip="Write all jog speeds to PLC"/>
            </StackPanel>

            <!-- ========================================================= -->
            <!-- ===================== RIGHT SIDE ======================== -->
            <!-- ========================================================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= JOG PAD AREA ================= -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <TextBlock Text="Jog Control" Foreground="#87CEEB" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <Grid HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <!-- X- (Up) -->
                        <Button Grid.Row="0" Grid.Column="1" Content="X-" Height="50" Margin="5" 
                            x:Name="JogXMinusBtn" Tag="JogXMinus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold" FontSize="14"/>

                        <!-- Y+ (Left) -->
                        <Button Grid.Row="1" Grid.Column="0" Content="Y+" Height="50" Margin="5" 
                            x:Name="JogYPlusBtn" Tag="JogYPlus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold" FontSize="14"/>

                        <!-- Center JOG indicator -->
                        <Button Grid.Row="1" Grid.Column="1" Content="JOG" Height="50" Margin="5" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold" FontSize="14" IsEnabled="False" Click="Button_Click"/>

                        <!-- Y- (Right) -->
                        <Button Grid.Row="1" Grid.Column="2" Content="Y-" Height="50" Margin="5" 
                            x:Name="JogYMinusBtn" Tag="JogYMinus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold" FontSize="14"/>

                        <!-- X+ (Down) -->
                        <Button Grid.Row="2" Grid.Column="1" Content="X+" Height="50" Margin="5" 
                            x:Name="JogXPlusBtn" Tag="JogXPlus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold" FontSize="14"/>
                    </Grid>

                    <!-- Z Axis Jog (for robots with Z axis) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Z+" Width="80" Height="40" Margin="5" 
                            x:Name="JogZPlusBtn" Tag="JogZPlus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold"/>
                        <Button Content="Z-" Width="80" Height="40" Margin="5" 
                            x:Name="JogZMinusBtn" Tag="JogZMinus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold" Click="JogZMinusBtn_Click"/>
                        <Button Content="Z-Trayin +" Width="80" Height="40" Margin="5" 
                            x:Name="JogZ61PlusBtn" Tag="JogZ61Plus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold"/>
                        <Button Content="Z-Trayin -" Width="80" Height="40" Margin="5" 
                            x:Name="JogZ61MinusBtn" Tag="JogZ61Minus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold" Click="JogZMinusBtn_Click"/>   
                    </StackPanel>

                    <!-- R/C Axis Jog (for robots with rotation) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="R+" Width="80" Height="40" Margin="5" 
                            x:Name="JogRPlusBtn" Tag="JogRPlus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold" Click="JogRPlusBtn_Click"/>
                        <Button Content="R-" Width="80" Height="40" Margin="5" 
                            x:Name="JogRMinusBtn" Tag="JogRMinus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold"/>
                        <Button Content="Z-TrayOut +" Width="80" Height="40" Margin="5" 
                            x:Name="JogZ62PlusBtn" Tag="JogZ62Plus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold"/>
                        <Button Content="Z-TrayOut -" Width="80" Height="40" Margin="5" 
                            x:Name="JogZ62MinusBtn" Tag="JogZ62Minus" 
                            PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold" Click="JogZMinusBtn_Click"/>   
                    </StackPanel>
                </StackPanel>

                <Separator Grid.Row="1" Background="#444" Margin="0,2,0,2"/>

                 <!--================= CYLINDER &amp; VACUUM =================-->                 
                <StackPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Center" x:Name="CylinderVacuumPanel">
                    <TextBlock Text="Cylinder &amp; Vacuum" Foreground="#87CEEB" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    
                        <StackPanel  Orientation="Horizontal" Margin="0,5" RenderTransformOrigin="0.5,0.5">                            
                            <Button Content="CLY-UP" Width="70" Height="35" Margin="5" 
                                x:Name="CylinderUpBtn" Tag="CylinderUp" 
                                PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                                Background="#232336" Foreground="White" BorderBrush="#444"/>    
                            <Button Content="CLY-DOWN" Width="70" Height="35" Margin="5" 
                                x:Name="CylinderDownBtn" Tag="CylinderDown" 
                                PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                                Background="#232336" Foreground="White" BorderBrush="#444"/>    
                            <Button Content="CLY-Tray-UP" Width="80" Height="35" Margin="5" 
                                x:Name="CylinderTrayUpBtn" Tag="CylinderTrayUp" 
                                PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                                Background="#232336" Foreground="White" BorderBrush="#444"  FontSize="10"/>
                            <Button Content="CLY-Tray-DOWN" Width="80" Height="35" Margin="5" 
                                x:Name="CylinderTrayDownBtn" Tag="CylinderTrayDown" 
                                PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                                Background="#232336" Foreground="White" BorderBrush="#444"  FontSize="10"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5" RenderTransformOrigin="0.5,0.5">
                            <Button Content="VACUUM-ON" Width="70" Height="35" Margin="5" 
                                x:Name="VacuumOnBtn" Tag="VacuumOn" 
                                PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                                Background="#232336" Foreground="White" BorderBrush="#444"  FontSize="10"/>
                            <Button Content="VACUUM-OFF" Width="70" Height="35" Margin="5" 
                                x:Name="VacuumOffBtn" Tag="VacuumOff" 
                                PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                                Background="#232336" Foreground="White" BorderBrush="#444"  FontSize="10"/>
                            <Button Content="VACUUM-Tray-ON" Width="80" Height="35" Margin="5" 
                                x:Name="VacuumTrayOnBtn" Tag="VacuumTrayOn" 
                                PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                                Background="#232336" Foreground="White" BorderBrush="#444"  FontSize="8"/>
                            <Button Content="VACUUM-Tray-OFF" Width="80" Height="35" Margin="5" 
                                x:Name="VacuumTrayOffBtn" Tag="VacuumTrayOff" 
                                PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" 
                                Background="#232336" Foreground="White" BorderBrush="#444"  FontSize="8"/>
                        </StackPanel>                    
                </StackPanel>              
            </Grid>
        </Grid>

        <!-- ================= EMERGENCY STOP ================= -->
        <Button Grid.Row="2" Content="EMERGENCY STOP" Height="50" FontSize="16" FontWeight="Bold"
            Background="#8B0000" Foreground="White" BorderBrush="#AA0000" BorderThickness="2"
            Click="EmergencyStop_Click" Margin="0,20,0,0"/>
    </Grid>
</Window>