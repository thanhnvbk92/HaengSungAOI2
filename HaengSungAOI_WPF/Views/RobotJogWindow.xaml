                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AZ2_Pos5_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="NG CV" Tag="HMI_AZ2_Pos6_PB" Width="70" Margin="2" Padding="3" 
