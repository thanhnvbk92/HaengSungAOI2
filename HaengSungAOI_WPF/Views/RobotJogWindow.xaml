                                            Background="{Binding LampStates[HMI_AZ2_Pos4_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Place" Tag="HMI_AZ2_Pos5_PB" Width="70" Margin="2" Padding="3" 
