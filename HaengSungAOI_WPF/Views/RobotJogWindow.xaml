                                            Background="{Binding LampStates[HMI_AX2_Pos6_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <Separator Grid.Row="1" Background="#444"/>

                        <!-- ================= AXIS Z2 ================= -->
                        <GroupBox Grid.Row="2" Foreground="White" BorderBrush="#444" FontWeight="Bold" Padding="5">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Axis Z2 - PCB Transfer Robot Z"/>
                                    <TextBlock Text=" [" Foreground="Gray"/>
                                    <TextBlock Text="{Binding PosZ, StringFormat={}{0:F3}}" Foreground="Yellow"/>
                                    <TextBlock Text=" mm]" Foreground="Gray"/>
                                </StackPanel>
                            </GroupBox.Header>
                            <StackPanel Margin="5" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Servo ON" Tag="HMI_AZ2_ServoON_PB" Width="70" Margin="2" Padding="3" 
