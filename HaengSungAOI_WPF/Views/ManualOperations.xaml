      <Button Content="Vacuum ON" Tag="HMI_Vacuum_Infeed_ON_PB" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Margin="5" Padding="5" Background="#232336" Foreground="White" BorderBrush="#444"/>
