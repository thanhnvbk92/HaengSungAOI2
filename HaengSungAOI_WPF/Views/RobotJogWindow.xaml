                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AC1_Move_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Idle" Tag="HMI_AC1_Pos1_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AC1_Pos1_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Pickup" Tag="HMI_AC1_Pos2_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AC1_Pos2_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Place" Tag="HMI_AC1_Pos3_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AC1_Pos3_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>                    
                    </Grid>

                    <!-- PCB Transfer Robot Axes (X2, Z2) -->
