<Window x:Name="MainWindow1" x:Class="HaengSungAOI_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HaengSungAOI_WPF"
        xmlns:vm="clr-namespace:VMControls.WPF.Release;assembly=VMControls.WPF.Release"
        xmlns:loc="clr-namespace:HaengSungAOI_WPF"
        xmlns:svgc1="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="AOI Interface" Height="1080" Width="1920" WindowState="Maximized"
        Topmost="False"
        Background="#1e1e2f" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown" Loaded="MainWindow1_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Nội dung -->
            <RowDefinition Height="30"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Sidebar - increased width for buttons -->
            <ColumnDefinition Width="*"/>
            <!-- Nội dung chính -->
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#2d2d3c" Padding="20,0">
            <DockPanel>
                <TextBlock Text="AOI MACHINE - PCB Inspection System" FontSize="24" Foreground="White" 
                           FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                <!-- Current Model Display -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="40,0,0,0">
                    <TextBlock Text="Current Model:" Foreground="LightGray" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#232336" BorderBrush="#444" BorderThickness="1" Padding="8,4" CornerRadius="3">
                        <TextBlock x:Name="CurrentModelNameTextBlock" Text="No Model Selected" 
                                   Foreground="#87CEEB" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Current EBR Display -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="20,0,0,0">
                    <TextBlock Text="EBR:" Foreground="LightGray" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#232336" BorderBrush="#444" BorderThickness="1" Padding="8,4" CornerRadius="3" Cursor="Hand" MouseLeftButtonDown="CurrentEbrTextBlock_MouseLeftButtonDown" ToolTip="Click để nhập EBR mới">
                        <TextBlock x:Name="CurrentEbrTextBlock" Text="{Binding CurrentEbrValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                   Foreground="#FFD700" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="Reset EBR" Margin="8,0,0,0" Padding="10,2"
                            Background="#3A3A4D" Foreground="White" BorderBrush="#555"
                            Click="ResetEbr_Click" />
                    <CheckBox x:Name="EnableScanOutCheckBox" Content="Bật ScanOut" Foreground="LightGray" FontSize="14" VerticalAlignment="Center" Margin="15,0,0,0" Checked="EnableScanOutCheckBox_Checked" Unchecked="EnableScanOutCheckBox_Unchecked" />
                    <CheckBox x:Name="IsByPassCheckBox" Content="Bật ByPass" Foreground="LightGray" FontSize="14" VerticalAlignment="Center" Margin="15,0,0,0" Checked="IsByPassCheckBox_Checked" Unchecked="IsByPassCheckBox_Unchecked" />
                </StackPanel>

                <!-- Error Status Display -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="30,0,0,0">
                    <TextBlock Text="Status:" Foreground="LightGray" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#232336" BorderBrush="#444" BorderThickness="1" Padding="8,4" CornerRadius="3">
                        <TextBlock x:Name="ErrorStatusTextBlock" Text="System OK" 
                                   Foreground="LimeGreen" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Flag Buttons and User Info -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,0,10,0">
                    <Button Width="54" Height="36" Margin="4,0" ToolTip="Vietnamese"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                            Click="FlagVN_Click">
                        <Image Width="54" Height="30" Stretch="Uniform" Source="resource/icons/flags/VN.png"/>
                    </Button>
                    <Button Width="54" Height="36" Margin="4,0" ToolTip="Korean"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                            Click="FlagKR_Click">
                        <Image Width="54" Height="30" Stretch="Uniform" Source="resource/icons/flags/KR.png"/>
                    </Button>
                    <Button Width="54" Height="36" Margin="4,0" ToolTip="English"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                            Click="FlagEN_Click">
                        <Image Width="54" Height="30" Stretch="Uniform" Source="resource/icons/flags/GB.png"/>
                    </Button>
                    <TextBlock Text="User: admin" Foreground="LightGray" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="16,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sidebar Menu with HMI Control Buttons -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" Background="#282838" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SidebarStackPanel" VerticalAlignment="Stretch">
                <!-- Existing Start/Stop buttons -->

                <!-- Separator -->
                <Border Height="2" Background="#444" Margin="5,10"/>
                
                <!-- HMI Control Buttons Section -->
                <TextBlock Text="HMI CONTROLS" Foreground="LightGray" FontSize="11" FontWeight="Bold" 
                           Margin="5,5,5,2" HorizontalAlignment="Center"/>
                
                <!-- Auto PB - MW0 / MW200 -->
                <Button x:Name="btnHMIAuto" Margin="5,3" Height="35" Tag="HMI_Auto_PB"
                        Background="#232336" Foreground="White" FontWeight="SemiBold" FontSize="12"
                        BorderBrush="#444" BorderThickness="1" 
                        PreviewMouseDown="HMIButton_MouseDown" PreviewMouseUp="HMIButton_MouseUp">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="lampHMIAuto" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock Text="Auto" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                
                <!-- Manual PB - MW1 / MW201 -->
                <Button x:Name="btnHMIManual" Margin="5,3" Height="35" Tag="HMI_Manual_PB"
                        Background="#232336" Foreground="White" FontWeight="SemiBold" FontSize="12"
                        BorderBrush="#444" BorderThickness="1"
                        PreviewMouseDown="HMIButton_MouseDown" PreviewMouseUp="HMIButton_MouseUp">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="lampHMIManual" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock Text="Manual" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                
                <!-- Reset PB - MW2 / MW202 -->
                <Button x:Name="btnHMIReset" Margin="5,3" Height="35" Tag="HMI_Reset_PB"
                        Background="#232336" Foreground="White" FontWeight="SemiBold" FontSize="12"
                        BorderBrush="#444" BorderThickness="1"
                        PreviewMouseDown="HMIButton_MouseDown" PreviewMouseUp="HMIButton_MouseUp">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="lampHMIReset" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock Text="Reset" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                
                <!-- Origin - MW3 / MW203 -->
                <Button x:Name="btnHMIOrigin" Margin="5,3" Height="35" Tag="HMI_Origin"
                        Background="#232336" Foreground="White" FontWeight="SemiBold" FontSize="12"
                        BorderBrush="#444" BorderThickness="1"
                        PreviewMouseDown="HMIButton_MouseDown" PreviewMouseUp="HMIButton_MouseUp">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="lampHMIOrigin" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock Text="Origin" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                
                <!-- Start - MW4 / MW204 -->
                <Button x:Name="btnHMIStart" Margin="5,3" Height="35" Tag="HMI_Start"
                        Background="#232336" Foreground="White" FontWeight="SemiBold" FontSize="12"
                        BorderBrush="#444" BorderThickness="1"
                        PreviewMouseDown="HMIButton_MouseDown" PreviewMouseUp="HMIButton_MouseUp">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="lampHMIStart" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock Text="Start" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                
                <!-- Stop - MW5 / MW205 -->
                <Button x:Name="btnHMIStop" Margin="5,3" Height="35" Tag="HMI_Stop"
                        Background="#232336" Foreground="White" FontWeight="SemiBold" FontSize="12"
                        BorderBrush="#444" BorderThickness="1"
                        PreviewMouseDown="HMIButton_MouseDown" PreviewMouseUp="HMIButton_MouseUp">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#232336"/>
