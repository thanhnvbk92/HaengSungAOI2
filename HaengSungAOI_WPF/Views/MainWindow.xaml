                    </Button.Content>
                </Button>-->
                
                <!-- Buzzer Off - MW9 / MW209 -->
                <Button x:Name="btnHMIBuzzerOff" Margin="5,3" Height="35" Tag="HMI_Buzzer_Off"
                        Background="#232336" Foreground="White" FontWeight="SemiBold" FontSize="12"
                        BorderBrush="#444" BorderThickness="1"
                        PreviewMouseDown="HMIButton_MouseDown" PreviewMouseUp="HMIButton_MouseUp">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="lampHMIBuzzerOff" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock Text="Buzzer Off" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                
                <!-- End Cycle - MW10 / MW210 -->
                <Button x:Name="btnHMIEndCycle" Margin="5,3" Height="35" Tag="HMI_End_Cycle"
                        Background="#232336" Foreground="White" FontWeight="SemiBold" FontSize="12"
                        BorderBrush="#444" BorderThickness="1"
                        PreviewMouseDown="HMIButton_MouseDown" PreviewMouseUp="HMIButton_MouseUp">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Template">
