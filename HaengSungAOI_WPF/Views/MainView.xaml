<UserControl x:Class="HaengSungAOI_WPF.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VMControls.WPF.Release;assembly=VMControls.WPF.Release"
             xmlns:loc="clr-namespace:HaengSungAOI_WPF"
             xmlns:svgc1="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d">

    <Grid Background="#1e1e2f">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= HEADER ================= -->

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#2d2d3c" Padding="20,0">
            <DockPanel>

                <TextBlock Text="AOI MACHINE - PCB Inspection System"
                           FontSize="24"
                           Foreground="White"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <!-- Current Model -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Margin="40,0,0,0">

                    <TextBlock Text="Current Model:"
                               Foreground="LightGray"
                               FontSize="14"
                               Margin="0,0,8,0"/>

                    <Border Background="#232336"
                            BorderBrush="#444"
                            BorderThickness="1"
                            Padding="8,4">

                        <TextBlock Text="{Binding CurrentModel}"
                                   Foreground="#87CEEB"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Status -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Margin="30,0,0,0">

                    <TextBlock Text="Status:"
                               Foreground="LightGray"
                               Margin="0,0,8,0"/>

                    <Border Background="#232336"
                            BorderBrush="#444"
                            BorderThickness="1"
                            Padding="8,4">

                        <TextBlock Text="{Binding ErrorStatus}"
                                   Foreground="LimeGreen"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ================= SIDEBAR ================= -->

        <ScrollViewer Grid.Row="1" Grid.Column="0"
                      Background="#282838"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <Border Height="2" Background="#444" Margin="5,10"/>

                <TextBlock Text="HMI CONTROLS"
                           Foreground="LightGray"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="5"
                           HorizontalAlignment="Center"/>

                <!-- NAVIGATION SECTION -->
                <TextBlock Text="NAVIGATION"
                           Foreground="#666"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="10,20,0,5"/>

                <Button Margin="5,3" Height="35"
                        Background="#232336" Foreground="White" BorderBrush="#444" BorderThickness="1"
                        Content="Model Config"
                        Command="{Binding ShowModelJobCommand}"/>

                <Button Margin="5,3" Height="35"
                        Background="#232336" Foreground="White" BorderBrush="#444" BorderThickness="1"
                        Content="History Data"
                        Command="{Binding ShowHistoryCommand}"/>

                <Button Margin="5,3" Height="35"
                        Background="#232336" Foreground="White" BorderBrush="#444" BorderThickness="1"
                        Content="Settings"
                        Command="{Binding ShowSettingsCommand}"/>

                <Button Margin="5,3" Height="35"
                        Background="#232336" Foreground="White" BorderBrush="#444" BorderThickness="1"
                        Content="Error List"
                        Command="{Binding ShowErrorListCommand}"/>

                <!-- HMI CONTROLS -->
                <TextBlock Text="CONTROLS"
                           Foreground="#666"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="10,20,0,5"/>

                <Button Margin="5,3"
                        Height="35"
                        Background="#232336"
                        Foreground="White"
                        BorderBrush="#444"
                        BorderThickness="1"
                        Command="{Binding ExecuteHMICommand}"
                        CommandParameter="HMI_Start">

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="Gray"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="Start"/>
                    </StackPanel>

                </Button>

            </StackPanel>

        </ScrollViewer>

        <!-- ================= MAIN CONTENT ================= -->

        <Grid Grid.Row="1" Grid.Column="1" Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- Camera -->
            <vm:VmFrontendControl Grid.Row="0"/>

            <!-- History -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding HistoryList}"
                      AutoGenerateColumns="False"
                      Background="#202030"
                      Foreground="White">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="PCB"
                                        Binding="{Binding PCBCode}"/>
                    <DataGridTextColumn Header="Result"
                                        Binding="{Binding Result}"/>
                </DataGrid.Columns>

            </DataGrid>

        </Grid>

        <!-- ================= STATUS BAR ================= -->

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="#2d2d3c"
                Padding="5">

            <DockPanel>

                <TextBlock Text="{Binding MachineStatus}"
                           Foreground="Orange"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"/>

            </DockPanel>

        </Border>

    </Grid>
</UserControl>


