<Window x:Name="ModelConfigWindow" x:Class="HaengSungAOI_WPF.Views.ModelConfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HaengSungAOI_WPF"
        xmlns:vm="clr-namespace:VMControls.WPF.Release;assembly=VMControls.WPF.Release"
        mc:Ignorable="d"
        Title="Model Configuration" Height="1080" Width="1920" WindowStartupLocation="CenterOwner"
        Background="#1e1e2f" ResizeMode="NoResize" WindowState="Maximized">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d3c" Padding="20,0">
            <DockPanel>
                <TextBlock Text="Model Configuration" FontSize="20" Foreground="White" 
                           FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button Content="X" Width="30" Height="30" FontSize="18" FontWeight="Bold"
                        Background="Transparent" Foreground="White" BorderBrush="Transparent"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding CloseCommand}" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Model List -->
            <Border Grid.Column="0" Background="#282838" Margin="0,0,10,0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Width="240">
                        <TextBlock Text="Model List" Foreground="White" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                        <ListBox Background="#303040" Foreground="White" BorderBrush="#444" Height="280" 
                                 ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="White" Margin="5"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Add Model" Margin="0,8,0,6" Height="30"
                                Background="#232336" Foreground="White" FontWeight="Bold" FontSize="11"
                                BorderBrush="#444" BorderThickness="1" Command="{Binding AddModelCommand}"/>
                        <Button Content="Duplicate Model" Margin="0,0,0,6" Height="30"
                                Background="#232336" Foreground="White" FontWeight="Bold" FontSize="11"
                                BorderBrush="#444" BorderThickness="1" Command="{Binding DuplicateModelCommand}"/>
                        <Button Content="Delete Model" Margin="0,0,0,6" Height="30"
                                Background="#232336" Foreground="White" FontWeight="Bold" FontSize="11"
                                BorderBrush="#444" BorderThickness="1" Command="{Binding DeleteModelCommand}"/>
                        <Button Content="Đổi Model (Download to PLC)" Margin="0,0,0,6" Height="30"
                                Background="#0A5A0A" Foreground="White" FontWeight="Bold" FontSize="11"
                                BorderBrush="#444" BorderThickness="1" Command="{Binding DownloadToPlcCommand}"/>

                        <TextBlock Text="Basic Settings" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,12,0,6"/>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Model Name:" Foreground="LightGray" Margin="0,0,0,3" FontSize="10"/>
                            <TextBox Height="26" Background="#303040" Foreground="White" 
                                     BorderBrush="#444" Padding="3" Text="{Binding SelectedModel.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Description:" Foreground="LightGray" Margin="0,0,0,3" FontSize="10"/>
                            <TextBox Height="40" Background="#303040" Foreground="White" 
                                     BorderBrush="#444" Padding="3" TextWrapping="Wrap" 
                                     AcceptsReturn="True" Text="{Binding SelectedModel.Description}" FontSize="10"/>
                        </StackPanel>

                        <TextBlock Text="Vision Solution" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,12,0,6"/>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Solution File:" Foreground="LightGray" Margin="0,0,0,3" FontSize="10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="26" Background="#303040" Foreground="White" 
                                         BorderBrush="#444" Padding="3" Text="{Binding SelectedModel.VisionSolutionName}" IsReadOnly="True" FontSize="9"/>
                                <Button Grid.Column="1" Content="..." Width="43" Height="26" Margin="2,0,0,0"
                                        Background="#232336" Foreground="White" FontWeight="Bold" FontSize="12"
                                        BorderBrush="#444" BorderThickness="1" Command="{Binding BrowseVisionFileCommand}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center Panel with TabControl -->
            <Border Grid.Column="1" Background="#282838" Padding="8">
                <TabControl Background="#282838" BorderBrush="#444" BorderThickness="1">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,8"/>
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="BorderBrush" Value="#444"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="12,2"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3c3c54"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Background" Value="#303040"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="AutoGenerateColumns" Value="False"/>
                            <Setter Property="CanUserAddRows" Value="False"/>
                            <Setter Property="HeadersVisibility" Value="Column"/>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- Robot Configuration Tab -->
                    <TabItem Header="Robot Configuration">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#232336" Padding="12">
                            <StackPanel>
                                <!-- Global Read/Write Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                                    <Button Content="Read All From PLC" Height="30" Width="140" Margin="0,0,10,0"
                                            Background="#4A7A4A" Foreground="White" FontWeight="Bold" 
                                            Command="{Binding ReadAllFromPlcCommand}"/>
                                    <Button Content="Write All To PLC" Height="30" Width="140"
                                            Background="#7A4A7A" Foreground="White" FontWeight="Bold" 
                                            Command="{Binding DownloadToPlcCommand}"/>
                                </StackPanel>

                                <!-- PCB Infeed Robot Section -->
                                <GroupBox Header="PCB Infeed Robot" Foreground="#87CEEB" BorderBrush="#444" Margin="0,0,0,20">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DataGrid x:Name="InfeedRobotGrid" Grid.Row="1" Height="200" ItemsSource="{Binding RobotPositionManager.InfeedPositions}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="100" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="X" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="Y" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="R" Binding="{Binding R, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </GroupBox>

                                <!-- PCB Transfer Robot Section -->
                                <GroupBox Header="PCB Transfer Robot" Foreground="#DDA0DD" BorderBrush="#444" Margin="0,0,0,20">
                                    <Grid Margin="8">
                                        <DataGrid x:Name="TransferRobotGrid" Height="150" ItemsSource="{Binding RobotPositionManager.TransferPositions}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="120" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="X" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="Z" Binding="{Binding Z, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </GroupBox>

                                <!-- PCB Outfeed Robot Section -->
                                <GroupBox Header="PCB Outfeed Robot" Foreground="#F0E68C" BorderBrush="#444" Margin="0,0,0,20">
                                    <Grid Margin="8">
                                        <DataGrid x:Name="OutfeedRobotGrid" Height="150" ItemsSource="{Binding RobotPositionManager.OutfeedPositions}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="120" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="X" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="Y" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="R" Binding="{Binding R, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </GroupBox>

                                <!-- Inspect 1 Robot Section -->
                                <GroupBox Header="Inspect 1 Robot" Foreground="#98FB98" BorderBrush="#444" Margin="0,0,0,20">
                                    <Grid Margin="8">
                                        <DataGrid x:Name="Inspect1RobotGrid" Height="150" ItemsSource="{Binding RobotPositionManager.Inspect1Positions}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="120" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="X" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="Y" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="Z" Binding="{Binding Z, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </GroupBox>

                                <!-- Inspect 2 Robot Section -->
                                <GroupBox Header="Inspect 2 Robot" Foreground="#FFA07A" BorderBrush="#444" Margin="0,0,0,20">
                                    <Grid Margin="8">
                                        <DataGrid x:Name="Inspect2RobotGrid" Height="150" ItemsSource="{Binding RobotPositionManager.Inspect2Positions}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="120" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="X" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="Y" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="Z" Binding="{Binding Z, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Vision Configuration Tab -->
                    <TabItem Header="Vision Configuration">
                        <Grid Background="#232336" Margin="5">
                            <vm:VmMainViewConfigControl x:Name="ProcedureConfigControl" Margin="10"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#2d2d3c" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Width="80" Height="35" Margin="0,0,10,0"
                        Background="#232336" Foreground="White" FontWeight="Bold" 
                        Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Width="80" Height="35"
                        Background="#232336" Foreground="White" FontWeight="Bold" 
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Border>

        <!-- Busy Overlay -->
        <Grid Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#2d2d3c" Padding="30" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding BusyMessage}" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <ProgressBar IsIndeterminate="False" Value="{Binding ProgressValue}" Height="15" Width="300" Foreground="#00FF00" Background="#1e1e2f"/>
                    <TextBlock Text="{Binding ProgressValue, StringFormat={}{0}%}" Foreground="White" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>


