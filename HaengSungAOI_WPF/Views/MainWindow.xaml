                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="lampHMISingleBlock" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock Text="Single Block" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>-->
                
                <!-- Next Step PB - MW8 / MW208 -->
                <!--<Button x:Name="btnHMINextStep" Margin="5,3" Height="35" Tag="HMI_Next_Step_PB"
                        Background="#232336" Foreground="White" FontWeight="SemiBold" FontSize="12"
                        BorderBrush="#444" BorderThickness="1"
                        PreviewMouseDown="HMIButton_MouseDown" PreviewMouseUp="HMIButton_MouseUp">
                    <Button.Style>
