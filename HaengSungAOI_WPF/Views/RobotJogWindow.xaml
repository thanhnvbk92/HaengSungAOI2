                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX2_Pos3_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Pre Place" Tag="HMI_AX2_Pos4_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX2_Pos4_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Place" Tag="HMI_AX2_Pos5_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX2_Pos5_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="NG CV" Tag="HMI_AX2_Pos6_PB" Width="70" Margin="2" Padding="3" 
