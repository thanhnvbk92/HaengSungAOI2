<Window x:Class="HaengSungAOI_WPF.Views.ErrorListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HaengSungAOI_WPF"
        xmlns:views="clr-namespace:HaengSungAOI_WPF.Views"
        mc:Ignorable="d"
        Title="Machine Error List" Height="600" Width="900" 
        Background="#1e1e2f"
        WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <!-- Boolean to Acknowledged Text Converter -->
        <views:BoolToAcknowledgedConverter x:Key="BoolToAcknowledgedConverter"/>
        <!-- Boolean to Color Brush Converter -->
        <views:BoolToAcknowledgedBrushConverter x:Key="BoolToAcknowledgedBrushConverter"/>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with filter controls -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Error Type:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="cbErrorType" Width="150" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All Types"/>
                    <ComboBoxItem Content="Information"/>
                    <ComboBoxItem Content="Warning"/>
                    <ComboBoxItem Content="Error"/>
                    <ComboBoxItem Content="Critical"/>
                    <ComboBoxItem Content="Collision"/>
                    <ComboBoxItem Content="Timeout"/>
                    <ComboBoxItem Content="Hardware"/>
                    <ComboBoxItem Content="Vision"/>
                    <ComboBoxItem Content="Communication"/>
                    <ComboBoxItem Content="PLC"/>
                    <ComboBoxItem Content="Robot"/>
                    <ComboBoxItem Content="Safety"/>
                    <ComboBoxItem Content="System"/>
                </ComboBox>

                <TextBlock Text="Status:" Foreground="White" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <ComboBox x:Name="cbStatus" Width="150" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Acknowledged"/>
                    <ComboBoxItem Content="Unacknowledged"/>
                </ComboBox>
            </StackPanel>

            <TextBox x:Name="txtSearch" Grid.Column="1" Margin="20,0" 
                     VerticalAlignment="Center" ToolTip="Search by source or message"
                     TextChanged="txtSearch_TextChanged"
                     BorderBrush="#444" Background="#252538" Foreground="White"/>
            
            <Button x:Name="btnRefresh" Grid.Column="2" Content="Refresh" Width="80" 
                    Click="btnRefresh_Click"
                    Background="#232336" Foreground="White" BorderBrush="#444"/>
        </Grid>

        <!-- Error list -->
        <DataGrid x:Name="dgErrors" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="dgErrors_SelectionChanged"
                  Background="#252538"
                  BorderBrush="#444"
                  Foreground="White"
                  RowBackground="#303040"
                  AlternatingRowBackground="#383848"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#444">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="150"/>
                <DataGridTextColumn Header="Type" Binding="{Binding ErrorType}" Width="100"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Acknowledged, Converter={StaticResource BoolToAcknowledgedConverter}}" 
                                       Foreground="{Binding Acknowledged, Converter={StaticResource BoolToAcknowledgedBrushConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            
            <DataGrid.Resources>
                <!-- Row Style -->
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorType}" Value="Critical">
                            <Setter Property="Background" Value="#4f222d"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorType}" Value="Error">
                            <Setter Property="Background" Value="#3a3a59"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorType}" Value="Warning">
                            <Setter Property="Background" Value="#403a2a"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
        </DataGrid>

        <!-- Error details -->
        <Expander Grid.Row="2" Header="Error Details" IsExpanded="True" 
                  Foreground="White" Background="#2d2d3c" 
                  BorderBrush="#444" Margin="0,10,0,10">
            <Grid Background="#252538" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Source:" Foreground="White" Margin="5"/>
                    <TextBlock Grid.Column="1" x:Name="txtDetailsSource" Foreground="LightBlue" Margin="5" TextWrapping="Wrap"/>
                    
                    <TextBlock Grid.Column="2" Text="Type:" Foreground="White" Margin="5"/>
                    <TextBlock Grid.Column="3" x:Name="txtDetailsType" Foreground="LightBlue" Margin="5" TextWrapping="Wrap"/>
                </Grid>
                
                <TextBox Grid.Row="1" x:Name="txtDetails" Height="100" TextWrapping="Wrap" 
                         IsReadOnly="True" Margin="5" BorderBrush="#444" 
                         Background="#2a2a40" Foreground="White"/>
            </Grid>
        </Expander>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnAcknowledgeAll" Content="Acknowledge All" Width="120" Margin="5"
                    Click="btnAcknowledgeAll_Click"
                    Background="#232336" Foreground="White" BorderBrush="#444">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#404040"/>
                                <Setter Property="Foreground" Value="#808080"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="btnClose" Content="Close" Width="80" Margin="5"
                    Click="btnClose_Click"
                    Background="#232336" Foreground="White" BorderBrush="#444"/>
        </StackPanel>
    </Grid>
</Window>