                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Axis C1 - PCB Infeed Robot Rotation"/>
                                    <TextBlock Text=" [" Foreground="Gray"/>
                                    <TextBlock Text="{Binding PosR, StringFormat={}{0:F3}}" Foreground="Yellow"/>
                                    <TextBlock Text=" mm]" Foreground="Gray"/>
                                </StackPanel>
                            </GroupBox.Header>
                            <StackPanel Margin="5" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Servo ON" Tag="HMI_AC1_ServoON_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AC1_ServoON_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                    <Button Content="ORG" Tag="HMI_AC1_ORG_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AC1_ORG_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Move" Tag="HMI_AC1_Move_PB" Width="70" Margin="2" Padding="3" 
