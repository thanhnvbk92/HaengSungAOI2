                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="lampHMIEndCycle" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock Text="Yêu cầu lấy tray" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                
                <!-- Counter Reset PB - MW11 -->
                <Button x:Name="btnHMICounterReset" Margin="5,3" Height="35" Tag="HMI_Counter_Reset_PB"
                        Background="#232336" Foreground="White" FontWeight="SemiBold" FontSize="12"
                        BorderBrush="Red"  BorderThickness="1"
                        PreviewMouseDown="HMIButton_MouseDown" PreviewMouseUp="HMIButton_MouseUp">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Template">
                                <Setter.Value>
