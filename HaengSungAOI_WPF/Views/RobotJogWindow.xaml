                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX2_ORG_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Move" Tag="HMI_AX2_Move_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX2_Move_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                                            Foreground="White" BorderBrush="#444"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Content="Idle" Tag="HMI_AX2_Pos1_PB" Width="70" Margin="2" Padding="3" 
                                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            Background="{Binding LampStates[HMI_AX2_Pos1_PB], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>
