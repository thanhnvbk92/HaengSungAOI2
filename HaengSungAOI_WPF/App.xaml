<Application x:Class="HaengSungAOI_WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HaengSungAOI_WPF"
             xmlns:vm="clr-namespace:VMControls.WPF.Release;assembly=VMControls.WPF.Release"
             xmlns:conv="clr-namespace:HaengSungAOI_WPF.Converters">
    <Application.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <conv:BooleanToBrushConverter x:Key="LampBrushConverter" TrueBrush="Lime" FalseBrush="Gray"/>
        <conv:BooleanToBrushConverter x:Key="BoolToLampBrushConverter" TrueBrush="#00FF00" FalseBrush="#232336"/>
        <!-- DataGrid Header Style for Dark Background -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#232336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#444"/>
        </Style>
    </Application.Resources>
</Application>



