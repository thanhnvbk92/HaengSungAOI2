    <Button Content="Move to Idle" Tag="HMI_PCB_Infeed_Move_to_Idle_PB" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Margin="5" Padding="5" Background="#232336" Foreground="White" BorderBrush="#444"/>
