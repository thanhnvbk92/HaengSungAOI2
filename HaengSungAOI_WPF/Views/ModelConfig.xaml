<Window x:Name="ModelConfigWindow" x:Class="HaengSungAOI_WPF.ModelConfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HaengSungAOI_WPF"
        xmlns:vm="clr-namespace:VMControls.WPF.Release;assembly=VMControls.WPF.Release"
mc:Ignorable="d"
        Title="Model Configuration" Height="1080" Width="1920" WindowStartupLocation="CenterOwner"
    Background="#1e1e2f" ResizeMode="NoResize" WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d3c" Padding="20,0" Grid.ColumnSpan="2">
            <DockPanel>
                <TextBlock Text="Model Configuration" FontSize="20" Foreground="White" 
 FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button Content="X" Width="30" Height="30" FontSize="18" FontWeight="Bold"
         Background="Transparent" Foreground="White" BorderBrush="Transparent"
         HorizontalAlignment="Right" VerticalAlignment="Center"
               Click="Close_Click" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="10" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Model List -->
            <Border Grid.Column="0" Background="#282838" Margin="0,0,10,0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Width="240">
                        <TextBlock Text="Model List" Foreground="White" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                        <ListBox Background="#303040" Foreground="White" BorderBrush="#444" Height="280" Name="ModelListBox">
                            <ListBoxItem Content="Model 1" Background="#232336" Foreground="White"/>
                            <ListBoxItem Content="Model 2" Background="#232336" Foreground="White"/>
                            <ListBoxItem Content="Model 3" Background="#232336" Foreground="White"/>
                        </ListBox>
                        <Button Content="Add Model" Margin="0,8,0,6" Height="30"
      Background="#232336" Foreground="White" FontWeight="Bold" FontSize="11"
     BorderBrush="#444" BorderThickness="1" Click="AddModel_Click"/>
                        <Button Content="Duplicate Model" Margin="0,0,0,6" Height="30"
         Background="#232336" Foreground="White" FontWeight="Bold" FontSize="11"
  BorderBrush="#444" BorderThickness="1" Click="DuplicateModel_Click"/>
                        <Button Content="Delete Model" Margin="0,0,0,6" Height="30"
   Background="#232336" Foreground="White" FontWeight="Bold" FontSize="11"
   BorderBrush="#444" BorderThickness="1" Click="DeleteModel_Click"/>
                        <Button Content="Đổi Model" Margin="0,0,0,6" Height="30"
     Background="#0A5A0A" Foreground="White" FontWeight="Bold" FontSize="11"
       BorderBrush="#444" BorderThickness="1" Click="SetActiveModel_Click"/>

                        <TextBlock Text="Basic Settings" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,12,0,6"/>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Model Name:" Foreground="LightGray" Margin="0,0,0,3" FontSize="10"/>
                            <TextBox Height="26" Background="#303040" Foreground="White" 
   BorderBrush="#444" Padding="3" Name="ModelNameTextBox" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Description:" Foreground="LightGray" Margin="0,0,0,3" FontSize="10"/>
                            <TextBox Height="40" Background="#303040" Foreground="White" 
                 BorderBrush="#444" Padding="3" TextWrapping="Wrap" 
       AcceptsReturn="True" Name="DescriptionTextBox" FontSize="10"/>
                        </StackPanel>
                        <CheckBox IsEnabled="False" Content="Enable Auto Mode" Foreground="White" Margin="0,4" FontSize="10"/>
                        <CheckBox IsEnabled="False" Content="Save Results" Foreground="White" Margin="0,2" FontSize="10"/>

                        <TextBlock Text="Vision Solution" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,12,0,6"/>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Solution File:" Foreground="LightGray" Margin="0,0,0,3" FontSize="10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBox IsEnabled="False" Grid.Column="0" Height="26" Background="#303040" Foreground="White" 
     BorderBrush="#444" Padding="3" Name="VisionSolutionNameTextBox" IsReadOnly="True" FontSize="9"/>
                                <Button Grid.Column="1" Content="..." Width="43" Height="26" Margin="2,0,0,0"
   Background="#232336" Foreground="White" FontWeight="Bold" FontSize="12"
          BorderBrush="#444" BorderThickness="1" Click="BrowseVisionSolution_Click"
          ToolTip="Browse for vision solution file"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Solution Path:" Foreground="LightGray" Margin="0,0,0,3" FontSize="10"/>
                            <TextBox IsEnabled="False" Height="35" Background="#303040" Foreground="White" 
            BorderBrush="#444" Padding="3" TextWrapping="Wrap" 
     IsReadOnly="True" Name="VisionSolutionPathTextBox" FontSize="9"/>
                        </StackPanel>
                        <Button IsEnabled="False" Content="Copy to Model Dir" Height="28" Margin="0,0,0,5" FontSize="10"
     Background="#232336" Foreground="White" FontWeight="Bold" 
        BorderBrush="#444" BorderThickness="1" Click="CopyVisionSolution_Click"
   ToolTip="Copy to Model Directory"/>
                        <Button IsEnabled="False" Content="Open Vision Editor" Height="28" Margin="0,0,0,5" FontSize="10"
     Background="#232336" Foreground="White" FontWeight="Bold" 
    BorderBrush="#444" BorderThickness="1" Click="OpenVisionEditor_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center Panel with TabControl -->
            <Border x:Name="CenterPanel" Grid.Column="1" Background="#282838" Padding="8">
                <TabControl x:Name="MainTabControl" Background="#282838" BorderBrush="#444" BorderThickness="1" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,8"/>
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="BorderBrush" Value="#444"/>
                            <Setter Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
           BorderThickness="{TemplateBinding BorderThickness}"
  Padding="{TemplateBinding Padding}">
                                            <ContentPresenter x:Name="ContentSite"
           VerticalAlignment="Center"
     HorizontalAlignment="Center"
                   ContentSource="Header"
          Margin="12,2,12,2"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3c3c54"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#2a2a3a"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="TabControl">
                            <Setter Property="Background" Value="#282838"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabControl">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="#282838"/>
                                            <Border Grid.Row="1" Background="#282838" BorderBrush="#444" BorderThickness="0,1,0,0">
                                                <ContentPresenter ContentSource="SelectedContent"/>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Background" Value="#303040"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#444"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="GridLinesVisibility" Value="All"/>
                            <Setter Property="HorizontalGridLinesBrush" Value="#555"/>
                            <Setter Property="VerticalGridLinesBrush" Value="#555"/>
                            <Setter Property="HeadersVisibility" Value="Column"/>
                            <Setter Property="AutoGenerateColumns" Value="False"/>
                            <Setter Property="CanUserAddRows" Value="False"/>
                            <Setter Property="CanUserDeleteRows" Value="False"/>
                            <Setter Property="SelectionMode" Value="Single"/>
                            <Setter Property="SelectionUnit" Value="FullRow"/>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#232336"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="#444"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,4"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="#303040"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#555"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#404050"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#303040"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3a3a4a"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#404050"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Resources>

                    <!-- Robot Configuration Tab -->
                    <TabItem x:Name="RobotConfigTab" Header="Robot Configuration">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#232336" Padding="12">
                            <StackPanel>
                                <!-- Global Read/Write Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                                    <Button Content="Read All From PLC" Height="30" Width="140" Margin="0,0,10,0"
      Background="#4A7A4A" Foreground="White" FontWeight="Bold" FontSize="11"
                  BorderBrush="#444" BorderThickness="1" Click="ReadPositionsFromPLC_Click"
    ToolTip="Read all position data from PLC"/>
                                    <Button Content="Write All To PLC" Height="30" Width="140"
      Background="#7A4A7A" Foreground="White" FontWeight="Bold" FontSize="11"
     BorderBrush="#444" BorderThickness="1" Click="WritePositionsToPLC_Click"
 ToolTip="Write all position data to PLC"/>
                                </StackPanel>

                                <!-- PCB Infeed Robot Section -->
                                <GroupBox Header="PCB Infeed Robot (3-Axis)" Foreground="White" 
 BorderBrush="#444" Margin="0,0,0,20" Background="#232336">
                                    <GroupBox.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#87CEEB" FontWeight="Bold" FontSize="14"/>
                                        </DataTemplate>
                                    </GroupBox.HeaderTemplate>
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Current Position Display -->
                                        <Border Grid.Row="0" Background="#1a1a2a" BorderBrush="#87CEEB" BorderThickness="1" 
      Margin="0,0,0,10" Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Current Position:" Foreground="#87CEEB" FontWeight="Bold" 
        VerticalAlignment="Center" Width="110"/>
                                                <TextBlock Text="X:" Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                <TextBlock x:Name="InfeedCurrentX" Text="0.000" Foreground="#00FF00" FontWeight="Bold" 
   VerticalAlignment="Center" Width="80"/>
                                                <TextBlock Text="Y:" Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                <TextBlock x:Name="InfeedCurrentY" Text="0.000" Foreground="#00FF00" FontWeight="Bold" 
   VerticalAlignment="Center" Width="80"/>
                                                <TextBlock Text="R:" Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                <TextBlock x:Name="InfeedCurrentR" Text="0.000" Foreground="#00FF00" FontWeight="Bold" 
               VerticalAlignment="Center" Width="80"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Position Table -->
                                        <DataGrid Grid.Row="1" x:Name="InfeedRobotGrid" Height="150" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="100" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60"/>
                                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60"/>
                                                <DataGridTextColumn Header="R" Binding="{Binding R}" Width="60"/>
                                                <DataGridTextColumn Header="Speed X" Binding="{Binding SpeedX}" Width="70"/>
                                                <DataGridTextColumn Header="Speed Y" Binding="{Binding SpeedY}" Width="70"/>
                                                <DataGridTextColumn Header="Speed R" Binding="{Binding SpeedR}" Width="70"/>
                                                <DataGridTextColumn Header="Accel" Binding="{Binding Accel}" Width="60"/>
                                                <DataGridTextColumn Header="Decel" Binding="{Binding Decel}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <!-- Controls -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Button Content="Save Current Position" Height="25" Width="150" Margin="0,0,10,0"
         Background="#4A5A4A" Foreground="White" BorderBrush="#444"
         Click="SaveInfeedCurrentPosition_Click"/>
                                            <Button Content="Jog Controls" Height="25" Width="100"
 Background="#FFB347" Foreground="Black" BorderBrush="#444"
   Click="ShowInfeedJogControls_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- PCB Transfer Robot Section -->
                                <GroupBox Header="PCB Transfer Robot (2-Axis)" Foreground="White" 
             BorderBrush="#444" Margin="0,0,0,20" Background="#232336">
                                    <GroupBox.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#DDA0DD" FontWeight="Bold" FontSize="14"/>
                                        </DataTemplate>
                                    </GroupBox.HeaderTemplate>
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Current Position Display -->
                                        <Border Grid.Row="0" Background="#1a1a2a" BorderBrush="#DDA0DD" BorderThickness="1" 
           Margin="0,0,0,10" Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Current Position:" Foreground="#DDA0DD" FontWeight="Bold" 
      VerticalAlignment="Center" Width="110"/>
                                                <TextBlock Text="X:" Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                <TextBlock x:Name="TransferCurrentX" Text="0.000" Foreground="#00FF00" FontWeight="Bold" 
        VerticalAlignment="Center" Width="80"/>
                                                <TextBlock Text="Z:" Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                <TextBlock x:Name="TransferCurrentZ" Text="0.000" Foreground="#00FF00" FontWeight="Bold" 
             VerticalAlignment="Center" Width="80"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Position Table -->
                                        <DataGrid Grid.Row="1" x:Name="TransferRobotGrid" Height="170" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="120" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60"/>
                                                <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="60"/>
                                                <DataGridTextColumn Header="Speed X" Binding="{Binding SpeedX}" Width="70"/>
                                                <DataGridTextColumn Header="Speed Z" Binding="{Binding SpeedZ}" Width="70"/>
                                                <DataGridTextColumn Header="Accel" Binding="{Binding Accel}" Width="60"/>
                                                <DataGridTextColumn Header="Decel" Binding="{Binding Decel}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <!-- Controls -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Button Content="Save Current Position" Height="25" Width="150" Margin="0,0,10,0"
        Background="#4A5A4A" Foreground="White" BorderBrush="#444"
          Click="SaveTransferCurrentPosition_Click"/>
                                            <Button Content="Jog Controls" Height="25" Width="100"
 Background="#DDA0DD" Foreground="Black" BorderBrush="#444"
       Click="ShowTransferJogControls_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- PCB Outfeed Robot Section -->
                                <GroupBox Header="PCB Outfeed Robot (2-Axis)" Foreground="White" 
      BorderBrush="#444" Margin="0,0,0,20" Background="#232336">
                                    <GroupBox.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#98FB98" FontWeight="Bold" FontSize="14"/>
                                        </DataTemplate>
                                    </GroupBox.HeaderTemplate>
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Current Position Display -->
                                        <Border Grid.Row="0" Background="#1a1a2a" BorderBrush="#98FB98" BorderThickness="1" 
     Margin="0,0,0,10" Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Current Position:" Foreground="#98FB98" FontWeight="Bold" 
          VerticalAlignment="Center" Width="110"/>
                                                <TextBlock Text="X:" Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                <TextBlock x:Name="OutfeedCurrentX" Text="0.000" Foreground="#00FF00" FontWeight="Bold" 
         VerticalAlignment="Center" Width="80"/>
                                                <TextBlock Text="Y:" Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                <TextBlock x:Name="OutfeedCurrentY" Text="0.000" Foreground="#00FF00" FontWeight="Bold" 
                 VerticalAlignment="Center" Width="80"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Position Table -->
                                        <DataGrid Grid.Row="1" x:Name="OutfeedRobotGrid" Height="250" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="120" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60"/>
                                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60"/>
                                                <DataGridTextColumn Header="Speed X" Binding="{Binding SpeedX}" Width="70"/>
                                                <DataGridTextColumn Header="Speed Y" Binding="{Binding SpeedY}" Width="70"/>
                                                <DataGridTextColumn Header="Accel" Binding="{Binding Accel}" Width="60"/>
                                                <DataGridTextColumn Header="Decel" Binding="{Binding Decel}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <!-- Controls -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Button Content="Save Current Position" Height="25" Width="150" Margin="0,0,10,0"
              Background="#4A5A4A" Foreground="White" BorderBrush="#444"
      Click="SaveOutfeedCurrentPosition_Click"/>
                                            <Button Content="Jog Controls" Height="25" Width="100"
        Background="#90EE90" Foreground="Black" BorderBrush="#444"
   Click="ShowOutfeedJogControls_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- Inspect 1 Robot Section -->
                                <GroupBox Header="Inspect 1 Robot (Camera 2 Focus + PCB Rotate 1)" Foreground="White" 
     BorderBrush="#444" Margin="0,0,0,20" Background="#232336">
                                    <GroupBox.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#00BFFF" FontWeight="Bold" FontSize="14"/>
                                        </DataTemplate>
                                    </GroupBox.HeaderTemplate>
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Current Position Display -->
                                        <Border Grid.Row="0" Background="#1a1a2a" BorderBrush="#00BFFF" BorderThickness="1" 
         Margin="0,0,0,10" Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Current Position:" Foreground="#00BFFF" FontWeight="Bold" 
      VerticalAlignment="Center" Width="110"/>
                                                <TextBlock Text="Z:" Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                <TextBlock x:Name="Inspect1CurrentZ" Text="0.000" Foreground="#00FF00" FontWeight="Bold" 
            VerticalAlignment="Center" Width="80"/>
                                                <TextBlock Text="C:" Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                <TextBlock x:Name="Inspect1CurrentC" Text="0.000" Foreground="#00FF00" FontWeight="Bold" 
  VerticalAlignment="Center" Width="80"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Position Table -->
                                        <DataGrid Grid.Row="1" x:Name="Inspect1RobotGrid" Height="130" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="100" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="60"/>
                                                <DataGridTextColumn Header="C" Binding="{Binding C}" Width="60"/>
                                                <DataGridTextColumn Header="Speed Z" Binding="{Binding SpeedZ}" Width="70"/>
                                                <DataGridTextColumn Header="Speed C" Binding="{Binding Speed}" Width="70"/>
                                                <DataGridTextColumn Header="Accel" Binding="{Binding Accel}" Width="60"/>
                                                <DataGridTextColumn Header="Decel" Binding="{Binding Decel}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <!-- Controls -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Button Content="Save Current Position" Height="25" Width="150" Margin="0,0,10,0"
      Background="#4A5A4A" Foreground="White" BorderBrush="#444"
     Click="SaveInspect1CurrentPosition_Click"/>
                                            <Button Content="Jog Controls" Height="25" Width="100"
    Background="#00BFFF" Foreground="Black" BorderBrush="#444"
              Click="ShowInspect1JogControls_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- Inspect 2 Robot Section -->
                                <GroupBox Header="Inspect 2 Robot (Camera 3 Focus + PCB Rotate 2)" Foreground="White" 
      BorderBrush="#444" Margin="0,0,0,20" Background="#232336">
                                    <GroupBox.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#FF8C00" FontWeight="Bold" FontSize="14"/>
                                        </DataTemplate>
                                    </GroupBox.HeaderTemplate>
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Current Position Display -->
                                        <Border Grid.Row="0" Background="#1a1a2a" BorderBrush="#FF8C00" BorderThickness="1" 
        Margin="0,0,0,10" Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Current Position:" Foreground="#FF8C00" FontWeight="Bold" 
           VerticalAlignment="Center" Width="110"/>
                                                <TextBlock Text="Z:" Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                <TextBlock x:Name="Inspect2CurrentZ" Text="0.000" Foreground="#00FF00" FontWeight="Bold" 
       VerticalAlignment="Center" Width="80"/>
                                                <TextBlock Text="C:" Foreground="LightGray" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                                <TextBlock x:Name="Inspect2CurrentC" Text="0.000" Foreground="#00FF00" FontWeight="Bold" 
 VerticalAlignment="Center" Width="80"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Position Table -->
                                        <DataGrid Grid.Row="1" x:Name="Inspect2RobotGrid" Height="130" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="100" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="60"/>
                                                <DataGridTextColumn Header="C" Binding="{Binding C}" Width="60"/>
                                                <DataGridTextColumn Header="Speed Z" Binding="{Binding SpeedZ}" Width="70"/>
                                                <DataGridTextColumn Header="Speed C" Binding="{Binding Speed}" Width="70"/>
                                                <DataGridTextColumn Header="Accel" Binding="{Binding Accel}" Width="60"/>
                                                <DataGridTextColumn Header="Decel" Binding="{Binding Decel}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <!-- Controls -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Button Content="Save Current Position" Height="25" Width="150" Margin="0,0,10,0"
     Background="#4A5A4A" Foreground="White" BorderBrush="#444"
           Click="SaveInspect2CurrentPosition_Click"/>
                                            <Button Content="Jog Controls" Height="25" Width="100"
  Background="#FF8C00" Foreground="Black" BorderBrush="#444"
       Click="ShowInspect2JogControls_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Vision Procedure Configuration Tab -->
                    <TabItem x:Name="tab_2" Header="Vision Configuration">
                        <Grid Background="#232336" Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Vision Procedure Configuration" Foreground="White" 
         FontWeight="Bold" FontSize="16" Margin="20,20,20,10"/>
                            <Border Grid.Row="1" Background="#232336" BorderBrush="#444" BorderThickness="1" Margin="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <vm:VmMainViewConfigControl Grid.Column="0" x:Name="ProcedureConfigControl" Margin="10"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#2d2d3c" Padding="20,10" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply" Width="80" Height="35" Margin="0,0,10,0"
Background="#232336" Foreground="White" FontWeight="Bold" 
      BorderBrush="#444" BorderThickness="1" Click="Apply_Click"/>
                <Button Content="Save" Width="80" Height="35" Margin="0,0,10,0"
        Background="#232336" Foreground="White" FontWeight="Bold" 
    BorderBrush="#444" BorderThickness="1" Click="Save_Click"/>
                <Button Content="Cancel" Width="80" Height="35"
      Background="#232336" Foreground="White" FontWeight="Bold" 
     BorderBrush="#444" BorderThickness="1" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>