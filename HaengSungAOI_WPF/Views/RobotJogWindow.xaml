                <Separator Margin="10,15,10,10" Background="#444"/>

                <Button Content="Read All Speeds" Height="30" Width="180" Margin="5" Background="#4A4A7A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Command="{Binding ReadAllSpeedsCommand}" ToolTip="Read all jog speeds from PLC"/>
                <Button Content="Write All Speeds" Height="30" Width="180" Margin="5" Background="#4A7A4A" Foreground="White" FontWeight="Bold" BorderBrush="#444" Command="{Binding WriteAllSpeedsCommand}" ToolTip="Write all jog speeds to PLC"/>
            </StackPanel>

            <!-- ========================================================= -->
            <!-- ===================== RIGHT SIDE ======================== -->
            <!-- ========================================================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= JOG PAD AREA ================= -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <TextBlock Text="Jog Control" Foreground="#87CEEB" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <Grid HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <!-- X- (Up) -->
                        <Button Grid.Row="0" Grid.Column="1" Content="X-" Height="50" Margin="5" 
                            x:Name="JogXMinusBtn" Tag="JogXMinus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogXMinus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold" FontSize="14"/>

                        <!-- Y+ (Left) -->
                        <Button Grid.Row="1" Grid.Column="0" Content="Y+" Height="50" Margin="5" 
                            x:Name="JogYPlusBtn" Tag="JogYPlus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogYPlus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold" FontSize="14"/>

                        <!-- Center JOG indicator -->
                        <Button Grid.Row="1" Grid.Column="1" Content="JOG" Height="50" Margin="5" 
                            Background="#232336" Foreground="White" BorderBrush="#444" FontWeight="Bold" FontSize="14" IsEnabled="False"/>

                        <!-- Y- (Right) -->
                        <Button Grid.Row="1" Grid.Column="2" Content="Y-" Height="50" Margin="5" 
                            x:Name="JogYMinusBtn" Tag="JogYMinus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogYMinus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold" FontSize="14"/>

                        <!-- X+ (Down) -->
                        <Button Grid.Row="2" Grid.Column="1" Content="X+" Height="50" Margin="5" 
                            x:Name="JogXPlusBtn" Tag="JogXPlus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogXPlus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold" FontSize="14"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Z+" Width="80" Height="40" Margin="5" 
                            x:Name="JogZPlusBtn" Tag="JogZPlus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogZPlus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold"/>
                        <Button Content="Z-" Width="80" Height="40" Margin="5" 
                            x:Name="JogZMinusBtn" Tag="JogZMinus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogZMinus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold"/>
                        <Button Content="Z-Trayin +" Width="80" Height="40" Margin="5" 
                            x:Name="JogZ61PlusBtn" Tag="JogZ61Plus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogZ61Plus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold" Visibility="{Binding VisibilityJogZ61}"/>
                        <Button Content="Z-Trayin -" Width="80" Height="40" Margin="5" 
                            x:Name="JogZ61MinusBtn" Tag="JogZ61Minus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogZ61Minus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold" Visibility="{Binding VisibilityJogZ61}"/>   
                    </StackPanel>

                    <!-- R/C Axis Jog (for robots with rotation) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="R+" Width="80" Height="40" Margin="5" 
                            x:Name="JogRPlusBtn" Tag="JogRPlus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogRPlus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold"/>
                        <Button Content="R-" Width="80" Height="40" Margin="5" 
                            x:Name="JogRMinusBtn" Tag="JogRMinus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogRMinus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold"/>
                        <Button Content="Z-TrayOut +" Width="80" Height="40" Margin="5" 
                            x:Name="JogZ62PlusBtn" Tag="JogZ62Plus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogZ62Plus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold" Visibility="{Binding VisibilityJogZ62}"/>
                        <Button Content="Z-TrayOut -" Width="80" Height="40" Margin="5" 
                            x:Name="JogZ62MinusBtn" Tag="JogZ62Minus" 
                            utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                            utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                            utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                            Background="{Binding LampStates[JogZ62Minus], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" 
                            Foreground="White" BorderBrush="#444" FontWeight="Bold" Visibility="{Binding VisibilityJogZ62}"/>   
                    </StackPanel>
                </StackPanel>

                <Separator Grid.Row="1" Background="#444" Margin="0,2,0,2"/>

                 <!--================= CYLINDER &amp; VACUUM =================-->                 
                <StackPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Center" x:Name="CylinderVacuumPanel">
                    <TextBlock Text="Cylinder &amp; Vacuum" Foreground="#87CEEB" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    
                        <StackPanel  Orientation="Horizontal" Margin="0,5" RenderTransformOrigin="0.5,0.5">                            
                            <Button Content="CLY-UP" Width="70" Height="35" Margin="5" 
                                x:Name="CylinderUpBtn" Tag="CylinderUp" 
                                utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                Background="{Binding LampStates[CylinderUp], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>    
                            <Button Content="CLY-DOWN" Width="70" Height="35" Margin="5" 
                                x:Name="CylinderDownBtn" Tag="CylinderDown" 
                                utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                Background="{Binding LampStates[CylinderDown], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>    
                            <Button Content="CLY-Tray-UP" Width="80" Height="35" Margin="5" 
                                x:Name="CylinderTrayUpBtn" Tag="CylinderTrayUp" 
                                utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                Background="{Binding LampStates[CylinderTrayUp], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444" Visibility="{Binding VisibilityCylinderTray}"/>
                            <Button Content="CLY-Tray-DN" Width="80" Height="35" Margin="5" 
                                x:Name="CylinderTrayDownBtn" Tag="CylinderTrayDown" 
                                utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                Background="{Binding LampStates[CylinderTrayDown], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444" Visibility="{Binding VisibilityCylinderTray}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5" RenderTransformOrigin="0.5,0.5">
                            <Button Content="VAC-ON" Width="70" Height="35" Margin="5" 
                                x:Name="VacuumOnBtn" Tag="VacuumON" 
                                utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                Background="{Binding LampStates[VacuumON], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>    
                            <Button Content="VAC-OFF" Width="70" Height="35" Margin="5" 
                                x:Name="VacuumOffBtn" Tag="VacuumOFF" 
                                utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                Background="{Binding LampStates[VacuumOFF], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444"/>
                            <Button Content="VAC-Tray-ON" Width="80" Height="35" Margin="5" 
                                x:Name="VacuumTrayOnBtn" Tag="VacuumTrayON" 
                                utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                Background="{Binding LampStates[VacuumTrayON], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444" Visibility="{Binding VisibilityVacuumTray}"/>
                            <Button Content="VAC-Tray-OFF" Width="80" Height="35" Margin="5" 
                                x:Name="VacuumTrayOffBtn" Tag="VacuumTrayOFF" 
                                utils:ButtonMouseCommandBehavior.MouseDownCommand="{Binding ButtonDownCommand}"
                                utils:ButtonMouseCommandBehavior.MouseUpCommand="{Binding ButtonUpCommand}"
                                utils:ButtonMouseCommandBehavior.CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                Background="{Binding LampStates[VacuumTrayOFF], Converter={StaticResource BoolToLampBrushConverter}, FallbackValue=#232336}" Foreground="White" BorderBrush="#444" Visibility="{Binding VisibilityVacuumTray}"/>
                        </StackPanel>
                    
                </StackPanel>              
            </Grid>
        </Grid>

        <!-- ================= EMERGENCY STOP ================= -->
        <Button Grid.Row="2" Content="EMERGENCY STOP" Height="50" FontSize="16" FontWeight="Bold"
            Background="#8B0000" Foreground="White" BorderBrush="#AA0000" BorderThickness="2"
            Command="{Binding EmergencyStopCommand}" Margin="0,20,0,0"/>
    </Grid>
</Window>


