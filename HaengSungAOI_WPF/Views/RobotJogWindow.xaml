                                    <Button Content="Pickup" Tag="HMI_AX1_Pos2_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
                                    <Button Content="Place" Tag="HMI_AX1_Pos3_PB" Width="70" Margin="2" Padding="3" PreviewMouseDown="PLCButton_MouseDown" PreviewMouseUp="PLCButton_MouseUp" Background="#232336" Foreground="White" BorderBrush="#444"/>
